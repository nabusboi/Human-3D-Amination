# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure your local settings:
#   copy .env.example .env
# ==============================================================================

# Hardware Device: "cuda" for NVIDIA GPU or "cpu" for CPU inference
AVATAR_DEVICE=cuda

# Camera Index (default: 0 for built-in/primary webcam)
WEBCAM_INDEX=0

# Mirror Camera Preview (True/False)
MIRROR_WEBCAM=True

# Kaggle API Credentials (Optional - only needed for automated dataset downloading via script)
# Retrieve your key from https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
